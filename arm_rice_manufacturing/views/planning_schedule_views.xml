<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="planning_schedule_view_form" model="ir.ui.view">
        <field name="name">planning.schedule.view.form</field>
        <field name="model">planning.schedule</field>
        <field name="arch" type="xml">
            <form string="Planning Schedule">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_issue_materials" type="object" class="oe_stat_button" icon="fa-dropbox" invisible="state != 'confirmed'">
                            <span class="o_stat_text">Issue Materials</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Schedule Lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="plant"/>
                                    <field name="job_order_id" domain="[('state', 'in', ('confirmed', 'in_progress'))]"/>

                                    <!-- FIX: Added force_save="1" to all readonly mapped fields -->
                                    <field name="partner_id" readonly="1" force_save="1"/>
                                    <field name="product_id" readonly="1" force_save="1"/>
                                    <field name="input_qty" readonly="1" force_save="1"/>
                                    <field name="output_qty" readonly="1" force_save="1"/>
                                    <field name="efficiency" readonly="1" force_save="1"/>
                                    <field name="bags" readonly="1" force_save="1" sum="Total Bags"/>

                                    <!-- User Input Fields -->
                                    <field name="stock_packed"/>
                                    <field name="stock_to_be_packed"/>
                                    <field name="final_rice_mt_hr"/>
                                    <field name="prod_hours"/>
                                    <field name="prod_days"/>
                                    <field name="prod_shift"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="remarks"/>
                                </list>
                            </field>

                            <!-- Summary Footer mimicking the Report for Plant A, B, C -->
                            <group class="oe_subtotal_footer">
                                <group string="Plant A Capacity">
                                    <field name="total_plant_a_input" string="Total Input (M.Ton)"/>
                                    <field name="total_plant_a_output" string="Total Output (M.Ton)"/>
                                </group>
                                <group string="Plant B Capacity">
                                    <field name="total_plant_b_input" string="Total Input (M.Ton)"/>
                                    <field name="total_plant_b_output" string="Total Output (M.Ton)"/>
                                </group>
                                <group string="Plant C Capacity">
                                    <field name="total_plant_c_input" string="Total Input (M.Ton)"/>
                                    <field name="total_plant_c_output" string="Total Output (M.Ton)"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="planning_schedule_view_tree" model="ir.ui.view">
        <field name="name">planning.schedule.view.tree</field>
        <field name="model">planning.schedule</field>
        <field name="arch" type="xml">
            <list string="Planning Schedules">
                <field name="name"/>
                <field name="date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_planning_schedule" model="ir.actions.act_window">
        <field name="name">Planning Schedule</field>
        <field name="res_model">planning.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_planning_schedule"
              name="Planning Schedule"
              parent="menu_arm_rice_manufacturing"
              action="action_planning_schedule"
              sequence="16"/>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="master_plant_view_form" model="ir.ui.view">
        <field name="name">master.plant.view.form</field>
        <field name="model">master.plant</field>
        <field name="arch" type="xml">
            <form string="Plant">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="master_plant_view_tree" model="ir.ui.view">
        <field name="name">master.plant.view.tree</field>
        <field name="model">master.plant</field>
        <field name="arch" type="xml">
            <list string="Plants">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_master_plant" model="ir.actions.act_window">
        <field name="name">Plants</field>
        <field name="res_model">master.plant</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_master_plant"
              name="Plants"
              parent="stock.menu_stock_config_settings"
              action="action_master_plant"
              sequence="93"/>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="issue_material_view_form" model="ir.ui.view">
        <field name="name">issue.material.view.form</field>
        <field name="model">issue.material</field>
        <field name="arch" type="xml">
            <form string="Issue Material">
                <header>
                    <button name="action_confirm" string="Issue to Mill" type="object" class="btn-primary" invisible="state != 'draft'"/>

                    <!-- NEW BUTTONS: Visible only when Issue Material is Confirmed -->
                    <button name="action_create_production_log_sheet" string="Create Log Sheet" type="object" class="btn-warning" invisible="state != 'confirmed'"/>
                    <button name="action_create_production_qc" string="Create Quality Control" type="object" class="btn-warning" invisible="state != 'confirmed'"/>

                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('draft', 'cancel')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- FIX: Reverted to picking_id (singular) -->
                        <button name="action_view_picking" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_id">
                            <span class="o_stat_text">Transfer</span>
                        </button>
                        <!-- NEW SMART BUTTONS -->
                        <button name="action_view_production_log_sheets" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="state != 'confirmed'">
                            <field name="log_sheet_count" string="Log Sheets" widget="statinfo"/>
                        </button>
                        <button name="action_view_production_qcs" type="object" class="oe_stat_button" icon="fa-check-square-o" invisible="state != 'confirmed'">
                            <field name="qc_count" string="Quality Controls" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="issue_date"/>
                            <field name="milling_date" readonly="state != 'draft'"/>
                            <field name="rice_type" readonly="1"/>
                            <field name="job_order_id"/>
                            <field name="raw_rice_ids" widget="many2many_tags" readonly="1"/>
                            <field name="is_reworking" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="source_location_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                            <!-- FIX: Changed dest_location_id to dest_location_ids and added widget -->
                            <field name="dest_location_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                            <field name="total_issue_qty"/>
                            <field name="total_issue_bags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Rice Details">
                            <field name="issue_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="shell_id" string="Src Location"/>
                                    <field name="dest_id" string="Destination Location"/>
                                    <field name="qty_mt"/>
                                    <field name="qty_on_hand" readonly="1"/>
                                    <field name="bags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Remarks">
                            <field name="remarks" nolabel="1" colspan="2"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="issue_material_view_tree" model="ir.ui.view">
        <field name="name">issue.material.view.tree</field>
        <field name="model">issue.material</field>
        <field name="arch" type="xml">
            <list string="Issue Materials">
                <field name="name"/>
                <field name="issue_date"/>
                <field name="rice_type"/>
                <field name="job_order_id"/>
                <field name="is_reworking" readonly="state != 'draft'"/>
                <field name="total_issue_qty"/>
                <field name="total_issue_bags"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_issue_material" model="ir.actions.act_window">
        <field name="name">Issue Materials</field>
        <field name="res_model">issue.material</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_issue_material"
              name="Issue Materials"
              parent="menu_arm_rice_manufacturing"
              action="action_issue_material"
              sequence="30"/>
</odoo>
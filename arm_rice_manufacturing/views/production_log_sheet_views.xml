<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="production_log_sheet_view_form" model="ir.ui.view">
        <field name="name">production.log.sheet.view.form</field>
        <field name="model">production.log.sheet</field>
        <field name="arch" type="xml">
            <form string="Production Log Sheet">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                        invisible="state != 'draft'" />
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state in ('draft', 'cancel')" />
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                        class="btn-secondary"
                        invisible="state != 'cancel'" />
                    <button name="%(action_report_production_log_sheet)d" string="Print Report"
                        type="action" class="btn-secondary" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>

                    <!-- NEW: Plant Radio Buttons -->
                    <group string="Plant Selection">
                        <group>
                            <field name="show_bm1" string="BM 1"/>
                            <field name="bm1_plant" widget="radio" options="{'horizontal': true}" invisible="not show_bm1" />
                        </group>
                        <group>
                            <field name="show_bm2" string="BM 2"/>
                            <field name="bm2_plant" widget="radio" options="{'horizontal': true}" invisible="not show_bm2" />
                        </group>
                    </group>

                    <group readonly="state != 'draft'">
                        <group>
                            <!-- NEW: Issue Material Link -->
                            <field name="issue_material_id" options="{'no_create': True}" />
                            <!-- FIX: Reworking Checkbox in Form View -->
                            <field name="is_reworking" readonly="state != 'draft'" />
                            <field name="date" />
                            <field name="milling_date" readonly="state != 'draft'" />
                            <field name="day" />
                            <field name="shift" />
                            <field name="operator_name" />
                        </group>

                        <group>
                            <field name="customer_1_id" />
                            <field name="job_order_1_id"
                                domain="[('partner_id', '=', customer_1_id)]" />

                            <field name="first_finish_lot_location_id" />

                            <field name="customer_2_id" />
                            <field name="job_order_2_id"
                                domain="[('partner_id', '=', customer_2_id)]" />

                            <field name="second_finish_lot_location_id" />
                        </group>

                    </group>

                    <notebook>
                        <page string="Running Time">
                            <field name="running_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id" string="Item" />
                                    <field name="start_time" />
                                    <field name="stop_time" />
                                    <field name="actual_time" />
                                    <field name="remarks" />
                                </list>
                            </field>
                            <group>
                                <field name="total_running_time" readonly="state != 'draft'" />
                            </group>
                        </page>

                        <page string="Stop Time">
                            <field name="stop_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="stop_time" />
                                    <field name="start_time" />
                                    <field name="down_time" />
                                    <field name="remarks" />
                                </list>
                            </field>
                            <group>
                                <field name="total_down_time" readonly="state != 'draft'" />
                            </group>
                        </page>

                        <page string="Final Product Packing">
                            <field name="packing_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <!-- FIX: Changed from brand (Char) to product_id (Many2one) -->
                                    <field name="product_id" string="Brand" />
                                    <field name="variety" />
                                    <field name="no_of_bags" />
                                    <field name="packing_size" />
                                    <field name="total_weight" />
                                    <field name="percent" />
                                </list>
                            </field>
                        </page>

                        <page string="By-Product Summary">
                            <field name="byproduct_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <!-- DOMAIN ADDED: Sirf wahi products aayenge jispar Product
                                    form mein By Product check ho -->
                                    <field name="product_id" string="Item"
                                        domain="[('is_by_product', '=', True)]" />
                                    <field name="bags" />
                                    <field name="size" />
                                    <field name="weight" />
                                    <field name="percent" />
                                </list>
                            </field>
                        </page>

                        <page string="Sign-Off &amp; Remarks">
                            <group>
                                <field name="prepared_by" />
                                <field name="supervisor" />
                                <field name="production_head" />
                            </group>
                            <group string="Remarks">
                                <field name="remarks" nolabel="1" colspan="2" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="production_log_sheet_view_tree" model="ir.ui.view">
        <field name="name">production.log.sheet.view.tree</field>
        <field name="model">production.log.sheet</field>
        <field name="arch" type="xml">
            <list string="Production Log Sheets" decoration-info="state == 'confirmed'"
                decoration-muted="state == 'cancel'">
                <field name="name" />
                <field name="issue_material_id" />
                <field name="is_reworking" readonly="state != 'draft'" />
                <field name="date" />
                <field name="day" />
                <field name="shift" />
                <field name="operator_name" />
                <field name="job_order_1_id" />
                <field name="customer_1_id" />
                <field name="state" widget="badge" decoration-info="state == 'confirmed'"
                    decoration-muted="state == 'cancel'" />
            </list>
        </field>
    </record>

    <record id="action_production_log_sheet" model="ir.actions.act_window">
        <field name="name">Production Log Sheet</field>
        <field name="res_model">production.log.sheet</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_production_log_sheet" name="Production Log Sheet"
        parent="menu_arm_rice_manufacturing"
        action="action_production_log_sheet" sequence="45" />

    <!-- ========================================== -->
    <!-- CONFIGURATION: OPERATOR NAME VIEWS         -->
    <!-- ========================================== -->

    <!-- 1. Operator Name Form View -->
    <record id="operator_name_view_form" model="ir.ui.view">
        <field name="name">operator.name.view.form</field>
        <field name="model">operator.name</field>
        <field name="arch" type="xml">
            <form string="Operator Name">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 2. Operator Name List View -->
    <record id="operator_name_view_tree" model="ir.ui.view">
        <field name="name">operator.name.view.tree</field>
        <field name="model">operator.name</field>
        <field name="arch" type="xml">
            <list string="Operator Names">
                <field name="name" />
            </list>
        </field>
    </record>

    <!-- 3. Operator Name Action -->
    <record id="action_operator_name" model="ir.actions.act_window">
        <field name="name">Operator Names</field>
        <field name="res_model">operator.name</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- 4. Configuration Menu (Sequence 102 will place it right below Inspection Agencies) -->
    <menuitem id="menu_operator_name"
        name="Operator Names"
        parent="mrp.menu_mrp_configuration"
        action="action_operator_name"
        sequence="102" />

</odoo>
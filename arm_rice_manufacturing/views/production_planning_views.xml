<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="production_planning_view_form" model="ir.ui.view">
        <field name="name">production.planning.view.form</field>
        <field name="model">production.planning</field>
        <field name="arch" type="xml">
            <form string="Production Planning Sheet">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="%(arm_rice_manufacturing.action_report_production_planning)d"
                            string="Print Planning Sheet" type="action" class="oe_highlight"
                            invisible="state == 'cancel'"/>
                    <button name="action_create_issue_material" string="Create Issue Material" type="object"
                            class="btn-warning" invisible="state != 'confirmed'"/>
                    <button name="action_create_production_record" string="Create Production Record" type="object"
                            class="btn-success" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="job_order_id" readonly="state != 'draft'"/>
                            <!-- FIX: Added force_save="1" to all readonly mapped fields -->
                            <field name="commodity" readonly="1" force_save="1"/>
                            <field name="rice_variety" readonly="1" force_save="1"/>
                        </group>
                        <group>
                            <field name="customer_id" readonly="1" force_save="1"/>
                            <!-- ==================================================== -->
                            <!-- NEW: Milling Date Range (From - To)                  -->
                            <!-- Client requirement: 25 Apr 2026 to 30 Mar 2027        -->
                            <!-- ==================================================== -->
                            <field name="milling_date_from" readonly="state != 'draft'"/>
                            <field name="milling_date_to" readonly="state != 'draft'"/>
                            <field name="brand" readonly="1" force_save="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parameters">
                            <field name="planning_line_ids">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="sequence" readonly="1" force_save="1"/>
                                    <field name="parameter" readonly="1" force_save="1"/>
                                    <field name="uom" readonly="1" force_save="1"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                        <page string="Packing Details">
                            <group>
                                <group>
                                    <field name="no_of_bags" readonly="1" force_save="1"/>
                                    <field name="packing_material" readonly="1" force_save="1"/>
                                </group>
                                <group>
                                    <field name="empty_bag_weight" readonly="1" force_save="1"/>
                                    <field name="total_quantity" readonly="1" force_save="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="production_planning_view_tree" model="ir.ui.view">
        <field name="name">production.planning.view.tree</field>
        <field name="model">production.planning</field>
        <field name="arch" type="xml">
            <list string="Production Planning">
                <field name="name"/>
                <field name="date"/>
                <field name="job_order_id"/>
                <field name="customer_id"/>
                <!-- NEW: Milling Date range display column -->
                <field name="milling_date" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_production_planning" model="ir.actions.act_window">
        <field name="name">Production Planning</field>
        <field name="res_model">production.planning</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_production_planning"
              name="Production Planning"
              parent="menu_arm_rice_manufacturing"
              action="action_production_planning"
              sequence="20"/>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="master_brand_view_form" model="ir.ui.view">
        <field name="name">master.brand.view.form</field>
        <field name="model">master.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="master_brand_view_tree" model="ir.ui.view">
        <field name="name">master.brand.view.tree</field>
        <field name="model">master.brand</field>
        <field name="arch" type="xml">
            <list string="Brands">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_master_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">master.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_master_brand"
              name="Brands"
              parent="stock.menu_stock_config_settings"
              action="action_master_brand"
              sequence="92"/>
</odoo>
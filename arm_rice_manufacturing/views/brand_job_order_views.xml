<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="brand_job_order_view_form" model="ir.ui.view">
        <field name="name">brand.job.order.view.form</field>
        <field name="model">brand.job.order</field>
        <field name="arch" type="xml">
            <form string="Brand Job Order">
                <header>
                    <!-- Dynamic Approval Buttons -->
                    <button name="action_approve" string="Verify" type="object" class="oe_highlight"
                            invisible="not can_user_approve or pending_line_label != 'Verify'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="not can_user_approve or pending_line_label != 'Approve'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight"
                            invisible="not can_user_approve or pending_line_label in ('Verify', 'Approve', False)"/>
                    <button name="action_refuse" string="Refuse" type="object" class="btn-danger"
                            invisible="not can_user_approve"/>

                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                        invisible="state != 'draft' or (approval_status != 'approved' and not is_admin)" />
                    <button name="action_create_planning_sheet" string="Create Planning Sheet"
                        type="object" class="btn-primary" invisible="state != 'confirmed'" />

                    <!-- PRINT BUTTON -->
                    <button name="%(arm_rice_manufacturing.action_report_brand_job_order)d"
                        string="Print Job Order"
                        type="action" class="oe_highlight" invisible="state == 'draft'" />

                    <button name="action_create_issue_material" string="Create Issue Material"
                        type="object" class="btn-warning" invisible="1" />
                    <button name="action_create_production_record" string="Create Production Record"
                        type="object" class="btn-success" invisible="1" />
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state in ('draft', 'cancel')" />
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                        class="btn-secondary" invisible="state != 'cancel'" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirmed,in_progress,done" />
                </header>
                <sheet>
                    <!-- Invisible fields for view evaluation -->
                    <field name="can_edit_rfq" invisible="1"/>
                    <field name="can_user_approve" invisible="1"/>
                    <field name="approval_status" invisible="1"/>
                    <field name="pending_line_label" invisible="1"/>
                    <field name="is_admin" invisible="1"/>

                    <!-- Approval Status Banner -->
                    <div class="alert alert-info" role="alert" invisible="approval_status == 'approved' or not approval_line_ids">
                        <strong>Approval Status:</strong> <field name="approval_label" readonly="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="approval_status != 'refused'">
                        <strong>This Job Order has been Refused.</strong>
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_issue_materials" type="object"
                            class="oe_stat_button" icon="fa-dropbox">
                            <field name="issue_material_count" string="Issues" widget="statinfo" />
                        </button>
                        <button name="action_view_production_records" type="object"
                            class="oe_stat_button" icon="fa-cogs">
                            <field name="production_record_count" string="Productions"
                                widget="statinfo" />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" />
                            <field name="rice_type" readonly="1" />
                            <field name="process_rice_spec_id" />
                            <field name="prs_contract_id" invisible="1" />
                            <field name="rice_sales_contract_id"
                                domain="[('id', '=', prs_contract_id)]" />
                            <field name="partner_id" readonly="1" force_save="1" />
                            <field name="contract_date" readonly="1" force_save="1" />
                            <field name="destination_country" />
                            <field name="shipment_period" readonly="1" force_save="1" />
                        </group>
                        <group>
                            <field name="product_id" />
                            <field name="raw_rice_ids" widget="many2many_tags"
                                readonly="state != 'draft'" />
                            <field name="quantity_mt" />
                            <!-- FIX #2: 'packing' duplicate tha — ab sirf Packing tab mein hai -->
                            <field name="broken_percent" readonly="1" force_save="1" />
                            <field name="moisture_percent" readonly="1" force_save="1" />
                        </group>
                    </group>
                    <notebook>
                        <!-- Approval Matrix Tab -->
                        <page string="Approval Matrix" name="approval_matrix_page" invisible="not approval_line_ids">
                            <field name="approval_line_ids" readonly="1">
                                <list decoration-success="status == 'done'" decoration-danger="status == 'refuse'" decoration-warning="status == 'waiting'">
                                    <field name="label"/>
                                    <field name="employee_id" string="Expected Approver"/>
                                    <field name="group_id" string="Expected Group"/>
                                    <field name="approved_by_id" string="Approved By"/>
                                    <field name="status" widget="badge" decoration-success="status == 'done'" decoration-danger="status == 'refuse'" decoration-warning="status == 'waiting'"/>
                                    <field name="time_of_approval"/>
                                </list>
                            </field>
                        </page>

                        <!-- TAB 1: Packing -->
                        <!-- FIX #1: <group> notebook ke andar allowed nahi — <page> mein wrap kiya -->
                        <page string="Packing" name="packing_page">
                            <group name="packing_group">
                                <group>
                                    <field name="packing"/>
                                    <!-- ==================================================== -->
                                    <!-- UoM ke mutabiq conditional show/hide                  -->
                                    <!-- Kgs  -> Weight (Kgs) + PP Bags (Kgs) show, Lbs hide   -->
                                    <!-- Lbs  -> Weight (Lbs) show, Kgs fields hide            -->
                                    <!-- ==================================================== -->
                                    <field name="pp_bag_uom"/>
                                    <field name="pp_bag_kg" invisible="pp_bag_uom != 'kg'"/>
                                    <field name="pp_bag_lb" invisible="pp_bag_uom != 'lb'"/>
                                    <field name="pp_bags_kgs" invisible="pp_bag_uom != 'kg'"/>
                                </group>
                                <group>
                                    <field name="no_of_bags"/>
                                    <field name="empty_bag_weight"/>
                                    <!-- <field name="empty_bag_weight_additional"/> -->
                                    <field name="total_empty_bag_weight"/>
                                    <field name="net_weight"/>
                                    <field name="gross_weight"/>
                                </group>
                            </group>
                        </page>

                        <!-- TAB 2: Fumigation -->
                        <page string="Fumigation">
                            <group>
                                <group>
                                    <field name="fumigation_chemical" />
                                    <field name="fumigation_method" />
                                    <field name="fumigation_agency_id" />
                                </group>
                                <group>
                                    <field name="phyto_certificate_req" widget="radio"
                                        options="{'horizontal': true}" />
                                </group>
                            </group>
                        </page>

                        <!-- TAB 3: Export Sampling / Inspection -->
                        <page string="Export Sampling / Inspection">
                            <group>
                                <group>
                                    <field name="no_of_samples" />
                                    <field name="inspection_date" />
                                </group>
                                <group>
                                    <field name="inspection_agency" />
                                </group>
                            </group>
                        </page>

                        <page string="Remarks">
                            <field name="remarks" nolabel="1" colspan="2" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="brand_job_order_view_tree" model="ir.ui.view">
        <field name="name">brand.job.order.view.tree</field>
        <field name="model">brand.job.order</field>
        <field name="arch" type="xml">
            <list string="Brand Job Orders">
                <field name="name" />
                <field name="date" />
                <field name="rice_type" />
                <field name="partner_id" />
                <field name="product_id" />
                <field name="quantity_mt" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="action_brand_job_order" model="ir.actions.act_window">
        <field name="name">Brand Job Orders</field>
        <field name="res_model">brand.job.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_brand_job_order"
        name="Brand Job Orders"
        parent="menu_arm_rice_manufacturing"
        action="action_brand_job_order"
        sequence="20" />

    <!-- ========================================== -->
    <!-- CONFIGURATION: FUMIGATION AGENCY VIEWS     -->
    <!-- ========================================== -->

    <record id="fumigation_agency_view_form" model="ir.ui.view">
        <field name="name">fumigation.agency.view.form</field>
        <field name="model">fumigation.agency</field>
        <field name="arch" type="xml">
            <form string="Fumigation Agency">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fumigation_agency_view_tree" model="ir.ui.view">
        <field name="name">fumigation.agency.view.tree</field>
        <field name="model">fumigation.agency</field>
        <field name="arch" type="xml">
            <list string="Fumigation Agencies">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="action_fumigation_agency" model="ir.actions.act_window">
        <field name="name">Fumigation Agencies</field>
        <field name="res_model">fumigation.agency</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fumigation_agency_contacts"
        name="Fumigation Agencies"
        parent="mrp.menu_mrp_configuration"
        action="action_fumigation_agency"
        sequence="100" />

    <!-- ========================================== -->
    <!-- CONFIGURATION: INSPECTION AGENCY VIEWS     -->
    <!-- ========================================== -->

    <record id="inspection_agency_view_form" model="ir.ui.view">
        <field name="name">inspection.agency.view.form</field>
        <field name="model">inspection.agency</field>
        <field name="arch" type="xml">
            <form string="Inspection Agency">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="inspection_agency_view_tree" model="ir.ui.view">
        <field name="name">inspection.agency.view.tree</field>
        <field name="model">inspection.agency</field>
        <field name="arch" type="xml">
            <list string="Inspection Agencies">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="action_inspection_agency" model="ir.actions.act_window">
        <field name="name">Inspection Agencies</field>
        <field name="res_model">inspection.agency</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_inspection_agency_contacts"
        name="Inspection Agencies"
        parent="mrp.menu_mrp_configuration"
        action="action_inspection_agency"
        sequence="40" />

</odoo>
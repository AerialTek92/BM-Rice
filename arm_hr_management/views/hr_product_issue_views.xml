<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_product_issue_form" model="ir.ui.view">
        <field name="name">hr.product.issue.form</field>
        <field name="model">hr.product.issue</field>
        <field name="arch" type="xml">
            <form string="Product Issuance Batch">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_set_to_draft" string="Set to Draft" type="object" class="btn-secondary" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_amount" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Issued Products">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="product_id" required="1"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="subtotal" widget="monetary"/>
                                    <!-- FIX: Made column visible and added decoration colors for the badge -->
                                    <field name="state" widget="badge" decoration-success="state == 'deducted'" decoration-info="state == 'confirmed'" decoration-muted="state == 'draft'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_product_issue_tree" model="ir.ui.view">
        <field name="name">hr.product.issue.tree</field>
        <field name="model">hr.product.issue</field>
        <field name="arch" type="xml">
            <list string="Product Issuance Batches" decoration-info="state == 'confirmed'">
                <field name="name"/>
                <field name="date"/>
                <field name="total_amount" widget="monetary"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_hr_product_issue" model="ir.actions.act_window">
        <field name="name">Employee Product Issuances</field>
        <field name="res_model">hr.product.issue</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_product_issue_root" name="Product Issuances" parent="hr.menu_hr_root" sequence="90"/>
    <menuitem id="menu_hr_product_issue" name="Issuances" parent="menu_hr_product_issue_root" action="action_hr_product_issue" sequence="1"/>
</odoo>
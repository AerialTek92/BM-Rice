<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_hr_product_issue" model="ir.sequence">
            <field name="name">Employee Product Issue</field>
            <field name="code">hr.product.issue</field>
            <field name="prefix">EMP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Loan Request -->
        <record id="seq_hr_loan_request" model="ir.sequence">
            <field name="name">Loan Request Sequence</field>
            <field name="code">hr.loan.request</field>
            <field name="prefix">LOAN/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Salary Advance -->
        <record id="seq_hr_salary_advance" model="ir.sequence">
            <field name="name">Salary Advance Sequence</field>
            <field name="code">hr.salary.advance</field>
            <field name="prefix">ADV/</field>
            <field name="padding">4</field>
        </record>

        <!-- Sequence for Final Settlement -->
        <record id="seq_hr_final_settlement" model="ir.sequence">
            <field name="name">Final Settlement Sequence</field>
            <field name="code">hr.final.settlement</field>
            <field name="prefix">SETT/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Exit Request   -->
        <record id="seq_hr_exit" model="ir.sequence">
            <field name="name">Employee Exit Sequence</field>
            <field name="code">hr.exit</field>
            <field name="prefix">EXIT/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
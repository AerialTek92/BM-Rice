<odoo>
    <record id="view_transporter_setup_tree" model="ir.ui.view">
        <field name="name">transporter.setup.tree</field>
        <field name="model">transporter.setup</field>
        <field name="arch" type="xml">
            <list string="Transporter Setup">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View (Matching your Image) -->
    <record id="view_transporter_setup_form" model="ir.ui.view">
        <field name="name">transporter.setup.form</field>
        <field name="model">transporter.setup</field>
        <field name="arch" type="xml">
            <form string="Transporter Setup">
                <sheet>
                    <group>
                        <!-- Code field (Small) -->
                        <field name="code" style="width: 30%%"/>
                        <!-- Name field (Long) -->
                        <field name="name" placeholder="Enter Transporter Name..."/>
                        <!-- Optional link to Partner -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_transporter_setup" model="ir.actions.act_window">
        <field name="name">Transporter Setup</field>
        <field name="res_model">transporter.setup</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- This puts the menu inside the Contacts App top bar -->
    <menuitem id="menu_transporter_setup_contacts"
              name="Transporter"
              parent="contacts.menu_contacts"
              action="action_transporter_setup"
              sequence="6"/>
</odoo>
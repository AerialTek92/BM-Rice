<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend the standard Attendance form; do not create a replacement form. -->
    <record id="view_hr_attendance_form_inherit_biometric" model="ir.ui.view">
        <field name="name">hr.attendance.form.inherit.biometric</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Biometric Details">
                    <group>
                        <field name="enroll_number" readonly="1"/>
                        <field name="device_number"/>
                    </group>
                    <group>
                        <field name="check_in_code"/>
                        <field name="check_out_code"/>
                        <field name="is_biometric"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Tree/list view for biometric attendance records. -->
    <record id="view_hr_attendance_biometric_list" model="ir.ui.view">
        <field name="name">hr.attendance.biometric.list</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <list string="Biometric Attendance">
                <field name="employee_id"/>
                <field name="enroll_number"/>
                <field name="check_in"/>
                <field name="check_in_code"/>
                <field name="check_out"/>
                <field name="check_out_code"/>
                <field name="device_number"/>
                <field name="worked_hours"/>
                <field name="is_biometric" optional="hide"/>
            </list>
        </field>
    </record>
</odoo>

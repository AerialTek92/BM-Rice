<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_upload_wizard_form" model="ir.ui.view">
        <field name="name">bm.attendance.upload.wizard.form</field>
        <field name="model">bm.attendance.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Attendance XLS">
                <sheet>
                    <group invisible="state != 'draft'"
                           string="Select Biometric XLS File">
                        <field name="file" filename="file_name"
                               accepted_file_extensions=".xls,.xlsx"/>
                        <field name="file_name" invisible="1"/>
                    </group>

                    <group invisible="state != 'done'"
                           string="Import Summary">
                        <field name="total_rows"/>
                        <field name="created_pairs"/>
                        <field name="employees_created"/>
                        <field name="skipped_rows"/>
                        <field name="unmapped_employees"/>
                    </group>

                    <group invisible="state != 'done'" string="Details">
                        <field name="log" widget="text" nolabel="1"/>
                    </group>

                    <field name="state" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_import"
                            string="Import"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attendance_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Biometric XLS</field>
        <field name="res_model">bm.attendance.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_resource_calendar_form_inherit_shift" model="ir.ui.view">
        <field name="name">resource.calendar.form.inherit.shift</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">


             <xpath expr="//form/header" position="inside">
                <button
                    name="action_fetch_time_off_types"
                    type="object"
                    string="Fetch Time Off Types"
                    class="oe_highlight"
                    icon="fa-refresh"
                />
            </xpath>

            <xpath expr="//sheet/notebook" position="inside">

                <page string="Shift Settings">

                    <group string="Shift Information">
                        <group>
                            <field name="code"/>
                            <field name="short_name"/>
                            <field name="depart"/>
                        </group>
                    </group>

                    <group string="Time Settings">
                        <group>
                            <field name="mark_attendance_after"
                                   widget="float_time"/>
                            <field name="mark_absent_after"
                                   widget="float_time"/>
                            <field name="mark_late_after"
                                   widget="float_time"/>
                        </group>
                    </group>

                    <group string="Half Day Settings">
                        <group>
                            <field name="half_day_start"
                                   widget="float_time"/>
                            <field name="half_day_end"
                                   widget="float_time"/>
                        </group>
                    </group>

                    <group string="Overtime / Early Out">
                        <group>
                            <field name="over_time_start"
                                   widget="float_time"/>
                            <field name="mark_early_out"
                                   widget="float_time"/>
                        </group>
                    </group>

                    <group string="Break Settings">
                        <group>
                            <field name="break_start"
                                   widget="float_time"/>
                            <field name="break_end"
                                   widget="float_time"/>
                        </group>
                    </group>

                </page>
                <page string="Leaves Days">
                    <field name="leave_days_ids">
                        <list editable="bottom">
                            <field name="leave_type_id"/>
                            <field name="days"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
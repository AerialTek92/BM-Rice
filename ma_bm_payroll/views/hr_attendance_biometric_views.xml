<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================ -->
    <!-- LIST VIEW - EXACT CLIENT SHEET COLUMNS -->
    <!-- ============================================ -->
    <record id="hr_attendance_biometric_list" model="ir.ui.view">
        <field name="name">hr.attendance.biometric.list</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <list string="Biometric Attendance">
                
                <!-- EXACT CLIENT SHEET FIELDS ORDER -->
                <field name="head" invisible="1"/>
                <field name="attendance_date"/>
                <field name="time_to"/>
                <field name="check_in_code"/>
                <field name="enroll_number"/>
                <field name="employee_id"/>
                <field name="device_number"/>
                <field name="check_out_code"/>
                <field name="time_from"/>
                <field name="worked_hours" invisible="1"/>
                
                <!-- Hidden -->
                <field name="is_biometric" invisible="1"/>
                <field name="employee_name" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- KANBAN VIEW - Overview -->
    <!-- ============================================ -->
    <record id="hr_attendance_biometric_kanban" model="ir.ui.view">
        <field name="name">hr.attendance.biometric.kanban</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <kanban default_group_by="employee_id">
                <field name="employee_id"/>
                <field name="attendance_date"/>
                <field name="time_to"/>
                <field name="time_from"/>
                <field name="check_in_code"/>
                <field name="check_out_code"/>
                <field name="enroll_number"/>
                <field name="device_number"/>
                <field name="head"/>
                <field name="worked_hours"/>
                <field name="is_biometric"/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div><strong><t t-esc="record.attendance_date.value"/></strong></div>
                            <div>
                                <span class="badge badge-success">IN: <t t-esc="record.time_to.value or ''"/></span>
                                <span class="badge badge-danger">OUT: <t t-esc="record.time_from.value or ''"/></span>
                            </div>
                            <div><small>Hours: <t t-esc="record.worked_hours.value or 0"/></small></div>
                            <div t-if="record.device_number.value">
                                <small>Device: <t t-esc="record.device_number.value"/></small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- FORM VIEW -->
    <!-- ============================================ -->
    <record id="hr_attendance_biometric_form" model="ir.ui.view">
        <field name="name">hr.attendance.biometric.form</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <form string="Biometric Attendance">
                <sheet>
                    <group>
                        <group string="Employee Info">
                            <field name="employee_id"/>
                            <field name="enroll_number"/>
                            <field name="head"/>
                        </group>
                        <group string="Attendance Info">
                            <field name="attendance_date"/>
                            <field name="time_to"/>
                            <field name="check_in_code"/>
                            <field name="time_from"/>
                            <field name="check_out_code"/>
                            <field name="worked_hours"/>
                            <field name="device_number"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- SEARCH VIEW -->
    <!-- ============================================ -->
    <record id="hr_attendance_biometric_search" model="ir.ui.view">
        <field name="name">hr.attendance.biometric.search</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance">
                <field name="employee_id"/>
                <field name="enroll_number"/>
                <field name="attendance_date"/>
                
                <separator/>
                <filter name="filter_check_in" string="Check IN (0001)" domain="[('check_in_code', '=', '0001')]"/>
                <filter name="filter_check_out" string="Check OUT (0002)" domain="[('check_out_code', '=', '0002')]"/>
                <filter name="filter_biometric" string="Biometric" domain="[('is_biometric', '=', True)]"/>
                <filter name="filter_today" string="Today" domain="[('attendance_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                
                <separator/>
                <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                <filter name="group_date" string="Date" context="{'group_by': 'attendance_date'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================ -->
    <!-- ACTIONS -->
    <!-- ============================================ -->
    <record id="action_biometric_management" model="ir.actions.act_window">
        <field name="name">Biometric Attendance Management</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hr_attendance_biometric_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hr_attendance_biometric_form')}),
        ]"/>
        <field name="domain">[('is_biometric', '=', True)]</field>
        <field name="search_view_id" ref="hr_attendance_biometric_search"/>
    </record>

    <record id="action_biometric_overview" model="ir.actions.act_window">
        <field name="name">Attendance Overview</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('hr_attendance_biometric_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hr_attendance_biometric_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hr_attendance_biometric_form')}),
        ]"/>
        <field name="domain">[('is_biometric', '=', True)]</field>
        <field name="search_view_id" ref="hr_attendance_biometric_search"/>
        <field name="context">{'search_default_group_employee': 1}</field>
    </record>

    <!-- Upload Action -->
    <record id="action_upload_biometric_wizard" model="ir.actions.act_window">
        <field name="name">Upload Biometric XLS</field>
        <field name="res_model">bm.attendance.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Server Action for Upload Button -->
    <record id="server_action_upload_xls" model="ir.actions.server">
        <field name="name">⬆ Upload Biometric XLS</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = env.ref('ma_bm_attendance.action_upload_biometric_wizard').read()[0]
        </field>
    </record>

    <!-- ============================================ -->
    <!-- MENUS -->
    <!-- ============================================ -->
    <menuitem id="menu_bm_attendance_root"
              name="Attendance"
              parent="hr.menu_hr_root"
              sequence="30"/>
    
    <menuitem id="menu_bm_upload"
              name="Upload XLS"
              parent="menu_bm_attendance_root"
              action="action_upload_biometric_wizard"
              sequence="5"/>
    
    <menuitem id="menu_bm_management"
              name="Management"
              parent="menu_bm_attendance_root"
              action="action_biometric_management"
              sequence="10"/>
    
    <menuitem id="menu_bm_overview"
              name="Overview"
              parent="menu_bm_attendance_root"
              action="action_biometric_overview"
              sequence="20"/>

</odoo>
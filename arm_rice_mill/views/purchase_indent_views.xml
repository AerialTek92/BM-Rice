<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_indent_view_form" model="ir.ui.view">
        <field name="name">purchase.indent.view.form</field>
        <field name="model">purchase.indent</field>
        <field name="arch" type="xml">
            <form string="Purchase Indent">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_create_purchase_order" string="Create Purchase Order" type="object"
                            class="btn-warning" invisible="state != 'confirmed'"/>
                    <button name="action_create_material_issue_note" string="Create Material Issue Note" type="object"
                            class="btn-warning" invisible="state != 'confirmed'"/>
                    <button name="action_mark_done" string="Mark as Done" type="object" class="btn-success"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('draft', 'cancel')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="purchase_order_count" string="Purchase Orders" widget="statinfo"/>
                        </button>
                        <button name="action_view_material_issue_notes" type="object" class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="material_issue_note_count" string="Issue Notes" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="indent_date" readonly="state != 'draft'"/>
                            <field name="payment_mode" readonly="state != 'draft'"/>
                            <field name="department" readonly="state != 'draft'"/>
                            <field name="vendor_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="location_id" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Indent Items">
                            <field name="indent_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="description"/>
                                    <field name="uom_id"/>
                                    <field name="product_qty"/>
                                    <field name="rate"/>
                                    <field name="net_amount" readonly="1" sum="Total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <!-- Footer: Remarks -->
                    <group string="Remarks">
                        <field name="remarks" nolabel="1" colspan="2"
                               placeholder="e.g. ABOVE ITEMS ARE REQUIRED FOR REFINERY 400 &amp; 800 PLANT"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="purchase_indent_view_tree" model="ir.ui.view">
        <field name="name">purchase.indent.view.tree</field>
        <field name="model">purchase.indent</field>
        <field name="arch" type="xml">
            <list string="Purchase Indents">
                <field name="name"/>
                <field name="indent_date"/>
                <field name="payment_mode"/>
                <field name="department"/>
                <field name="vendor_id"/>
                <field name="location_id"/>
                <field name="total_net_amount" string="Total" sum="Total"/>
                <field name="purchase_order_count" string="POs"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_purchase_indent" model="ir.actions.act_window">
        <field name="name">Purchase Indents</field>
        <field name="res_model">purchase.indent</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_purchase_indent" name="Purchase Indents"
              parent="purchase.menu_purchase_root"
              action="action_purchase_indent" sequence="15"/>
</odoo>
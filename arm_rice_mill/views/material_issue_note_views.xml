<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="material_issue_note_view_form" model="ir.ui.view">
        <field name="name">material.issue.note.view.form</field>
        <field name="model">material.issue.note</field>
        <field name="arch" type="xml">
            <form string="Material Issue Note">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_check_availability" string="Check Availability" type="object"
                            class="btn-info" invisible="state != 'confirmed'"/>
                    <button name="action_issue_directly" string="Issue Directly" type="object"
                            class="btn-success" invisible="state != 'confirmed' or not availability_checked or not is_fully_available"/>
                    <button name="action_create_purchase_order" string="Create Purchase Order" type="object"
                            class="btn-warning" invisible="state != 'confirmed'"/>
                    <button name="action_mark_done" string="Mark as Done" type="object" class="btn-success"
                            invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('draft', 'cancel')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="purchase_order_count" string="Purchase Orders" widget="statinfo"/>
                        </button>
                        <button name="action_view_issue_transfer" type="object" class="oe_stat_button"
                                icon="fa-exchange" invisible="not issue_picking_id">
                            <span class="o_stat_text">Issue Transfer</span>
                        </button>
                    </div>
                    <!-- Invisible helpers for button visibility -->
                    <field name="is_fully_available" invisible="1"/>
                    <field name="availability_checked" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_type" readonly="1"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="department" readonly="state != 'draft'"/>
                            <field name="purchase_indent_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="remarks" nolabel="1" colspan="2" placeholder="Remarks / Reference No..."/>
                        </group>
                    </group>
                    <field name="material_issue_line_ids" readonly="state != 'draft'">
                        <list editable="bottom">
                            <field name="item_code" readonly="1"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="description"/>
                            <field name="uom_id"/>
                            <field name="product_qty" string="Quantity"/>
                            <field name="on_hand_qty" string="On Hand" readonly="1"/>
                            <field name="is_available" string="Available" widget="boolean_toggle" readonly="1"
                                   decoration-success="is_available" decoration-danger="not is_available"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="material_issue_note_view_tree" model="ir.ui.view">
        <field name="name">material.issue.note.view.tree</field>
        <field name="model">material.issue.note</field>
        <field name="arch" type="xml">
            <list string="Material Issue Notes">
                <field name="name"/>
                <field name="date"/>
                <field name="department"/>
                <field name="purchase_indent_id"/>
                <field name="is_fully_available" string="Available" optional="show"/>
                <field name="purchase_order_count" string="POs"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_material_issue_note" model="ir.actions.act_window">
        <field name="name">Material Issue Notes</field>
        <field name="res_model">material.issue.note</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_material_issue_note" name="Material Issue Notes"
              parent="purchase.menu_purchase_root" action="action_material_issue_note" sequence="16"/>
</odoo>
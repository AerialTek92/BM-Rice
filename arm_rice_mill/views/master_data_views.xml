<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View for Master Truck Type (Used for Create and Edit) -->
    <record id="master_truck_type_view_form" model="ir.ui.view">
        <field name="name">master.truck.type.view.form</field>
        <field name="model">master.truck.type</field>
        <field name="arch" type="xml">
            <form string="Truck Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="weighbridge_charges"/>
                            <field name="quantity_kgs"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View for Master Truck Type -->
    <record id="master_truck_type_view_tree" model="ir.ui.view">
        <field name="name">master.truck.type.view.tree</field>
        <field name="model">master.truck.type</field>
        <field name="arch" type="xml">
            <list string="Truck Types" editable="bottom">
                <field name="name"/>
                <field name="weighbridge_charges"/>
                <field name="quantity_kgs"/>
            </list>
        </field>
    </record>

    <!-- Action for Master Truck Type -->
    <record id="action_master_truck_type" model="ir.actions.act_window">
        <field name="name">Truck Types</field>
        <field name="res_model">master.truck.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Configuration Menu under Rice Operations -->
    <menuitem id="menu_arm_rice_config" name="Configuration" parent="menu_arm_rice_operations_root" sequence="90"/>
    <menuitem id="menu_master_truck_type" name="Truck Types" parent="menu_arm_rice_config" action="action_master_truck_type" sequence="10"/>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_rice_sales_contract" model="ir.sequence">
            <field name="name">Rice Sales Contract</field>
            <field name="code">rice.sales.contract</field>
            <field name="prefix">RSC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_grn_inspection" model="ir.sequence">
            <field name="name">GRN Inspection</field>
            <field name="code">grn.inspection</field>
            <field name="prefix">INS/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_grn_inspection_final" model="ir.sequence">
            <field name="name">GRN Final QC</field>
            <field name="code">grn.inspection.final.qc</field>
            <field name="prefix">QC</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_gate_pass" model="ir.sequence">
            <field name="name">Gate Pass</field>
            <field name="code">gate.pass</field>
            <field name="prefix">GP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_weighbridge_ticket" model="ir.sequence">
            <field name="name">Weighbridge Ticket</field>
            <field name="code">weighbridge.ticket</field>
            <field name="prefix">WB/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_payment_certificate" model="ir.sequence">
            <field name="name">Payment Certificate</field>
            <field name="code">payment.certificate</field>
            <field name="prefix">PC</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
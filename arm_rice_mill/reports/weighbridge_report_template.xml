<odoo>
    <!-- Paper Format (Landscape) -->
    <record id="paperformat_weighbridge_landscape" model="report.paperformat">
        <field name="name">Weighbridge Landscape</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_weighbridge_date_wise" model="ir.actions.report">
        <field name="name">Weighbridge Date Wise Report</field>
        <field name="model">weighbridge.date.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">arm_rice_mill.report_weighbridge_date_wise_template</field>
        <field name="report_file">arm_rice_mill.report_weighbridge_date_wise_template</field>
        <field name="print_report_name">'Weighbridge_DateWise_Report'</field>
        <field name="paperformat_id" ref="paperformat_weighbridge_landscape"/>
    </record>

    <!-- PDF Template -->
    <template id="report_weighbridge_date_wise_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page" style="font-size: 11px; font-family: sans-serif; color: black;">

                    <!-- Report Header -->
                    <div class="text-center" style="margin-bottom: 15px;">
                        <h4 style="font-weight: bold; margin-bottom: 0;">Bulk Management (Pakistan) Pvt. Ltd.</h4>
                        <h5 style="font-weight: bold;">Weighbridge Report</h5>
                        <div style="font-weight: bold;">
                            From:
                            <span t-esc="data['date_from']"/>
                            To:
                            <span t-esc="data['date_to']"/>
                        </div>
                    </div>

                    <!-- Main Table -->
                    <table class="table table-sm"
                           style="width: 100%; border-top: 2px solid black; border-bottom: 2px solid black;">
                        <thead>
                            <tr style="border-bottom: 2px solid black; text-align: center; vertical-align: middle;">
                                <th style="width: 8%;">Date</th>
                                <th style="width: 8%;">W/B No</th>
                                <th style="width: 10%;">Vehicle No</th>
                                <th style="width: 15%;">Material</th>
                                <th style="width: 15%;">Customer</th>
                                <th style="width: 15%;">Supplier</th>
                                <th style="width: 10%; text-align: right;">Gross Wt (Kg)</th>
                                <th style="width: 10%; text-align: right;">Tare Wt (Kg)</th>
                                <th style="width: 10%; text-align: right;">Net Wt (Kg)</th>
                                <th style="width: 5%; text-align: right;">Bags</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="l">
                                <tr style="border-bottom: 1px solid #ddd;">
                                    <td style="text-align: center;">
                                        <span t-esc="l['date']"/>
                                    </td>
                                    <td style="text-align: center;">
                                        <span t-esc="l['wb_no']"/>
                                    </td>
                                    <td style="text-align: center;">
                                        <span t-esc="l['vehicle']"/>
                                    </td>
                                    <td>
                                        <span t-esc="l['material']"/>
                                    </td>
                                    <td>
                                        <span t-esc="l['customer']"/>
                                    </td>
                                    <td>
                                        <span t-esc="l['supplier']"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-esc="'{0:,.0f}'.format(l['gross_wt'])"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-esc="'{0:,.0f}'.format(l['tare_wt'])"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-esc="'{0:,.0f}'.format(l['net_wt'])"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-esc="l['bags']"/>
                                    </td>
                                </tr>
                            </t>
                            <!-- Grand Total Row -->
                            <tr style="border-top: 2px solid black; font-weight: bold; font-size: 12px;">
                                <td colspan="6" style="text-align: right;">TOTAL:</td>
                                <td style="text-align: right;">
                                    <span t-esc="'{0:,.0f}'.format(total_gross)"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="'{0:,.0f}'.format(total_tare)"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="'{0:,.0f}'.format(total_net)"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="total_bags"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
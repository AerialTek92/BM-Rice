<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_gate_pass_local" model="ir.actions.report">
        <field name="name">Local Sales Gate Pass</field>
        <field name="model">gate.pass</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">arm_rice_mill.report_gate_pass_local_document</field>
        <field name="report_file">arm_rice_mill.report_gate_pass_local_document</field>
        <field name="binding_model_id" ref="model_gate_pass"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_gate_pass_local_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 12px; color: black;">

                        <!-- LOOP FOR 2 COPIES: Original and Driver Copy -->
                        <t t-foreach="['ORIGINAL', 'DRIVER COPY']" t-as="copy_type">

                            <!-- Main Container for each copy -->
                            <div style="margin-bottom: 40px; padding-bottom: 40px; border-bottom: 2px dashed #000;">

                                <!-- Header Block With Logo -->
                                <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 20px; width: 100%;">
                                    <!-- Left Side: Logo Element -->
                                    <div style="width: 20%; text-align: left;">
                                        <img t-if="res_company.logo"
                                             t-att-src="'data:image/png;base64,%s' % res_company.logo"
                                             style="max-height: 70px; max-width: 100%; object-fit: contain;"/>
                                    </div>

                                    <!-- Center: Company Titles -->
                                    <div style="width: 60%; text-align: center;">
                                        <h2 style="margin: 0; font-weight: bold; font-size: 20px; text-transform: uppercase;">
                                            Bulk Management (Pakistan) Pvt. Ltd.
                                        </h2>
                                        <div style="display: inline-block; border: 2px solid #000; padding: 5px 30px; margin-top: 10px;">
                                            <h3 style="margin: 0; font-weight: bold; text-transform: uppercase; font-size: 14px;">
                                                Local Sales Gate Pass (<span t-esc="copy_type"/>)
                                            </h3>
                                        </div>
                                    </div>

                                    <!-- Right Side: Blank Spacer -->
                                    <div style="width: 20%;"></div>
                                </div>

                                <!-- Top Info Grid (G.P.No, Date, D/O No, Truck No) -->
                                <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px;">
                                    <tr>
                                        <td style="border: 1px solid #000; padding: 6px; width: 15%; background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                            G.P NO
                                        </td>
                                        <td style="border: 1px solid #000; padding: 6px; width: 35%; text-align: center;">
                                            <span t-field="o.name"/>
                                        </td>
                                        <td style="border: 1px solid #000; padding: 6px; width: 15%; background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                            DATE
                                        </td>
                                        <td style="border: 1px solid #000; padding: 6px; width: 35%; text-align: center;">
                                            <span t-field="o.date" t-options='{"widget": "date"}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #000; padding: 6px; background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                            D/O NO
                                        </td>
                                        <td style="border: 1px solid #000; padding: 6px; text-align: center;">
                                            <span t-field="o.delivery_picking_id.name"/>
                                        </td>
                                        <td style="border: 1px solid #000; padding: 6px; background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                            TRUCK NO
                                        </td>
                                        <td style="border: 1px solid #000; padding: 6px; text-align: center;">
                                            <span t-field="o.vehicle_number"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid #000; padding: 6px; background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                            CUSTOMER
                                        </td>
                                        <td style="border: 1px solid #000; padding: 6px;" colspan="3">
                                            <span t-field="o.partner_id.name"/>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Product Lines Table (As per Image) -->
                                <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                                    <thead>
                                        <tr style="background-color: #f2f2f2;">
                                            <th style="border: 1px solid #000; padding: 8px; text-align: left; width: 60%;">
                                                DESCRIPTION OF GOODS
                                            </th>
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 15%;">
                                                BAGS
                                            </th>
                                            <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 25%;">
                                                NET WEIGHT (KGS)
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="o.gate_pass_line_ids" t-as="line">
                                            <tr>
                                                <td style="border: 1px solid #000; padding: 8px;">
                                                    <span t-field="line.product_id.name"/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                                    <span t-field="line.bags"/>
                                                </td>
                                                <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                                    <span t-field="line.net"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <!-- Totals Row -->
                                        <tr style="font-weight: bold; background-color: #f9f9f9;">
                                            <td style="border: 1px solid #000; padding: 8px; text-align: right;"
                                                colspan="1">TOTAL:
                                            </td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                                <span t-esc="sum(o.gate_pass_line_ids.mapped('bags'))"/>
                                            </td>
                                            <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                                <span t-esc="sum(o.gate_pass_line_ids.mapped('net'))"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <!-- Remarks -->
                                <div style="margin-bottom: 60px;">
                                    <strong>Remarks:</strong>
                                    <div style="border: 1px solid #ddd; padding: 10px; min-height: 30px; margin-top: 5px;">
                                        <span t-field="o.remarks"/>
                                    </div>
                                </div>

                                <!-- Signatures (As per Image) -->
                                <table style="width: 100%; margin-top: 50px;">
                                    <tr>
                                        <td style="width: 50%; text-align: center; vertical-align: bottom;">
                                            <div style="border-top: 1px solid #000; padding-top: 5px; margin: 0 40px;">
                                                <strong>Received By</strong>
                                            </div>
                                        </td>
                                        <td style="width: 50%; text-align: center; vertical-align: bottom;">
                                            <div style="border-top: 1px solid #000; padding-top: 5px; margin: 0 40px;">
                                                <strong>Authorised Signature</strong>
                                            </div>
                                        </td>
                                    </tr>
                                </table>

                            </div>

                            <!-- Page break between Original and Driver Copy -->
                            <t t-if="not copy_type_last">
                                <div style="page-break-before: always;"></div>
                            </t>

                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
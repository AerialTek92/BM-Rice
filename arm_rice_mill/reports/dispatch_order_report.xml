<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_dispatch_order_local" model="ir.actions.report">
        <field name="name">Local Sales Dispatch Order</field>
        <field name="model">gate.pass</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">arm_rice_mill.report_dispatch_order_local_document</field>
        <field name="report_file">arm_rice_mill.report_dispatch_order_local_document</field>
        <field name="binding_model_id" ref="model_gate_pass"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_dispatch_order_local_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 12px; color: black;">

                        <!-- Header -->
                        <div style="text-align: center; margin-bottom: 20px; border-bottom: 2px solid #000; padding-bottom: 10px;">
                            <h2 style="margin: 0; font-weight: bold; font-size: 22px;">Bulk Management (Pakistan) Pvt.
                                Ltd.
                            </h2>
                            <!-- Company Address & Contact Info -->
                            <div style="font-size: 10px; color: #555; margin-top: 5px; line-height: 1.4;">
                                <span t-field="env.company.partner_id"
                                      t-options='{"widget": "contact", "fields": ["address", "phone", "email"], "no_marker": True, "separator": " | "}'/>
                            </div>
                            <h3 style="margin: 10px 0 0 0; font-weight: bold; text-transform: uppercase; font-size: 16px;">
                                Dispatched Order
                            </h3>
                        </div>

                        <!-- Top Info Grid (Simplified as per Image) -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px; width: 20%; background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                    Customer Name
                                </td>
                                <td style="border: 1px solid #000; padding: 8px; width: 40%;">
                                    <span t-field="o.partner_id.name"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 8px; width: 15%; background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                    D/O No
                                </td>
                                <td style="border: 1px solid #000; padding: 8px; width: 25%; text-align: center;">
                                    <span t-field="o.delivery_picking_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px; background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                    Customer Address
                                </td>
                                <td style="border: 1px solid #000; padding: 8px;">
                                    <span t-field="o.partner_id"
                                          t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                                </td>
                                <td style="border: 1px solid #000; padding: 8px; background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                    Date
                                </td>
                                <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                    <span t-field="o.date" t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #000; padding: 8px; background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                    Vehicle No
                                </td>
                                <td style="border: 1px solid #000; padding: 8px;">
                                    <span t-field="o.vehicle_number"/>
                                </td>
                                <td style="border: 1px solid #000; padding: 8px; background-color: #f2f2f2; font-weight: bold; text-align: center;">
                                    Driver Name
                                </td>
                                <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                    <span t-field="o.driver_name"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Product Lines Table (Clean Layout as per Image) -->
                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                            <thead>
                                <tr style="background-color: #f2f2f2;">
                                    <th style="border: 1px solid #000; padding: 8px; text-align: left; width: 50%;">ITEM
                                        DESCRIPTION
                                    </th>
                                    <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 15%;">
                                        PACKING
                                    </th>
                                    <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 15%;">
                                        CTN / QTY
                                    </th>
                                    <th style="border: 1px solid #000; padding: 8px; text-align: center; width: 20%;">
                                        NET WEIGHT (KGS)
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.gate_pass_line_ids" t-as="line">
                                    <tr>
                                        <td style="border: 1px solid #000; padding: 8px;">
                                            <span t-field="line.product_id.name"/>
                                        </td>
                                        <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                            <span t-esc="line.product_id.piece_weight or 0.0"/>
                                            kg
                                        </td>
                                        <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                            <span t-field="line.bags"/>
                                        </td>
                                        <td style="border: 1px solid #000; padding: 8px; text-align: center; font-weight: bold;">
                                            <span t-field="line.net"/>
                                        </td>
                                    </tr>
                                </t>
                                <!-- Totals Row -->
                                <tr style="font-weight: bold; background-color: #f9f9f9;">
                                    <td style="border: 1px solid #000; padding: 8px; text-align: right;" colspan="2">
                                        TOTAL:
                                    </td>
                                    <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                        <span t-esc="sum(o.gate_pass_line_ids.mapped('bags'))"/>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 8px; text-align: center;">
                                        <span t-esc="sum(o.gate_pass_line_ids.mapped('net'))"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Signatures (As per Image) -->
                        <table style="width: 100%; margin-top: 80px;">
                            <tr>
                                <td style="width: 50%; text-align: center; vertical-align: bottom;">
                                    <div style="border-top: 1px solid #000; padding-top: 5px; margin: 0 30px;">
                                        <strong>Driver Signature</strong>
                                    </div>
                                </td>
                                <td style="width: 50%; text-align: center; vertical-align: bottom;">
                                    <div style="border-top: 1px solid #000; padding-top: 5px; margin: 0 30px;">
                                        <strong>Authorised Signature</strong>
                                    </div>
                                </td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
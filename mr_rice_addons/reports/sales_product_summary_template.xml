<odoo>
    <!-- Paper Format -->
    <record id="paperformat_sales_summary" model="report.paperformat">
        <field name="name">Sales Summary Landscape</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_sales_product_summary" model="ir.actions.report">
        <field name="name">Sales Product Summary</field>
        <field name="model">sales.product.summary.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">mr_rice_addons.report_sales_product_summary_template</field>
        <field name="report_file">mr_rice_addons.report_sales_product_summary_template</field>
        <field name="print_report_name">'Sales_Product_Summary_Report'</field>
        <field name="paperformat_id" ref="paperformat_sales_summary"/>
    </record>

    <!-- PDF Template -->
    <template id="report_sales_product_summary_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page" style="font-size: 12px; font-family: sans-serif; color: black;">

                    <!-- Report Header -->
                    <div class="text-center" style="margin-bottom: 10px;">
                        <h4 style="font-weight: bold; margin-bottom: 0;">Bulk Management (Pakistan) Pvt. Ltd.</h4>
                        <h5 style="font-weight: bold;">Sales Product Summary</h5>
                        <div style="font-weight: bold; font-size: 15px;">
                            <span t-esc="data['date_from']"/>
                            -
                            <span t-esc="data['date_to']"/>
                        </div>
                    </div>

                    <!-- Main Table (Exactly 6 Columns) -->
                    <table class="table table-sm"
                           style="width: 100%; border-top: 2px solid black; border-bottom: 2px solid black;">
                        <thead>
                            <tr style="border-bottom: 2px solid black; text-align: center; vertical-align: middle;">
                                <th style="width: 30%;">Product Name</th>
                                <th style="width: 8%; text-align: right;">Bag</th>
                                <th style="width: 8%; text-align: right;">Carton</th>
                                <th style="width: 12%; text-align: right;">Qty (Kgs)</th>
                                <th style="width: 15%; text-align: right;">Discount Sp.</th>
                                <th style="width: 27%; text-align: right;">Net Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="grouped_data" t-as="g">
                                <tr style="border-bottom: 1px solid #ddd;">
                                    <td>
                                        <span t-esc="g['product_template_id']"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-esc="g['bags']"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-esc="g['ctn']"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-esc="g['product_uom_qty']"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-esc="g['discount_special']"/>
                                    </td>
                                    <td style="text-align: right;">
                                        <span t-esc="g['net_amount']"/>
                                    </td>
                                </tr>
                            </t>
                            <!-- Grand Total -->
                            <tr style="border-top: 2px solid black; font-weight: bold;">
                                <td style="text-align: right;">GRAND TOTAL:</td>
                                <td style="text-align: right;">
                                    <span t-esc="grand_total_bags"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="grand_total_ctn"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="grand_total_weight"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="grand_total_disct"/>
                                </td>
                                <td style="text-align: right;">
                                    <span t-esc="grand_total_net"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
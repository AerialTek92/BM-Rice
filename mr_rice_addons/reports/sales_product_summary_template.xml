<odoo>
    <!-- Paper Format -->
    <record id="paperformat_sales_summary" model="report.paperformat">
        <field name="name">Sales Summary Landscape</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">15</field>
    </record>

    <!-- Report Action -->
    <record id="action_report_sales_product_summary" model="ir.actions.report">
        <field name="name">Sales Product Summary</field>
        <field name="model">sales.product.summary.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">mr_rice_addons.report_sales_product_summary_template</field>
        <field name="report_file">mr_rice_addons.report_sales_product_summary_template</field>
        <field name="print_report_name">'Sales_Product_Summary_Report'</field>
        <field name="paperformat_id" ref="paperformat_sales_summary"/>
    </record>

    <!-- PDF Template -->
    <template id="report_sales_product_summary_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <style>
                    .page {
                    font-family: Arial, sans-serif !important;
                    font-size: 11px !important;
                    color: black !important;
                    letter-spacing: 0.5px !important;
                    }

                    /* CUSTOM TABLE: No outer borders */
                    .rice-summary-table {
                    width: 100%;
                    border-collapse: collapse !important;
                    border: none !important; /* Pure table ka border khatam */
                    }

                    /* Header: Boxed according to image */
                    .rice-summary-table thead tr th {
                    border: 1.5px solid black !important;
                    text-align: center;
                    font-weight: bold;
                    padding: 5px;
                    }

                    /* BODY CELLS: STRICTLY NO SIDE BORDERS */
                    .rice-summary-table tbody tr td {
                    border-left: 0px hidden !important; /* Left line gayab */
                    border-right: 0px hidden !important; /* Right line gayab */
                    border-top: none !important;
                    border-bottom: none !important;
                    padding: 4px 2px !important;
                    vertical-align: middle;
                    }

                    /* Group Headings (e.g., BACHAT) */
                    .template-heading {
                    font-weight: bold !important;
                    text-transform: uppercase;
                    padding-top: 12px !important;
                    }

                    /* Subtotal Rows: Horizontal line only */
                    .sub-total-line td {
                    border-top: 1px solid black !important;
                    font-weight: bold !important;
                    }

                    /* Grand Total: Double line at bottom */
                    .grand-total-line td {
                    border-top: 2px solid black !important;
                    border-bottom: 4px double black !important;
                    font-weight: bold !important;
                    padding-top: 8px !important;
                    }

                    .text-right { text-align: right !important; }
                    .text-left { text-align: left !important; }
                </style>

                <div class="page">

                    <div class="header" style="width: 100%; text-align: right; font-size: 9px; margin-bottom: 0px;">
                        Page
                        <span class="page"/>
                        of
                        <span class="topage"/>
                    </div>

                    <div class="text-center" style="margin-bottom: 15px;">
                        <h5 style="font-weight: bold; margin: 0; text-decoration: underline;">Bulk Management (Pakistan)
                            Pvt. Ltd.
                        </h5>
                        <h6 style="font-weight: bold; margin: 2px;">Sales Product Summary</h6>
                        <div style="font-weight: bold;">
                            From: &amp;nbsp;
                            <span t-esc="data['date_from']"/> &amp;nbsp; To: &amp;nbsp;
                            <span t-esc="data['date_to']"/>
                        </div>
                    </div>

                    <!-- 'table' class nikaal di hai taaki default borders na aayein -->
                    <table class="rice-summary-table">
                        <thead>
                            <tr>
                                <th style="width: 40%;" class="text-left">Product Name</th>
                                <th style="width: 10%;" class="text-right">Bag</th>
                                <th style="width: 10%;" class="text-right">Carton</th>
                                <th style="width: 12%;" class="text-right">Qty (Kgs)</th>
                                <th style="width: 13%;" class="text-right">Discount Sp.</th>
                                <th style="width: 15%;" class="text-right">Net Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="grouped_data" t-as="g">
                                <!-- Main Group Title -->
                                <tr>
                                    <td colspan="6" class="template-heading">
                                        <span t-esc="g['template']"/>
                                    </td>
                                </tr>

                                <!-- Product Variants -->
                                <t t-foreach="g['variants']" t-as="v">
                                    <tr>
                                        <td class="text-left">
                                            <span t-esc="v['name']"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="'{0:,.0f}'.format(v['pcs'])"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="'{0:,.0f}'.format(v['ctn'])"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="'{0:,.0f}'.format(v['qty'])"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="'{0:,.2f}'.format(v['disct']) if v['disct'] > 0 else ''"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="'{0:,.0f}'.format(v['net'])"/>
                                        </td>
                                    </tr>
                                </t>

                                <!-- Group Sub-Total -->
                                <tr class="sub-total-line">
                                    <td></td>
                                    <td class="text-right">
                                        <span t-esc="'{0:,.0f}'.format(g['t_pcs'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:,.0f}'.format(g['t_ctn'])"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="'{0:,.0f}'.format(g['t_qty'])"/>
                                    </td>
                                    <td class="text-right"></td>
                                    <td class="text-right">
                                        <span t-esc="'{0:,.0f}'.format(g['t_net'])"/>
                                    </td>
                                </tr>
                            </t>

                            <!-- Grand Total Section -->
                            <tr class="grand-total-line">
                                <td class="text-right"></td>
                                <td class="text-right">
                                    <span t-esc="'{0:,.0f}'.format(grand_total_bags)"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{0:,.0f}'.format(grand_total_ctn)"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{0:,.0f}'.format(grand_total_weight)"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{0:,.2f}'.format(grand_total_disct) if grand_total_disct > 0 else ''"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="'{0:,.0f}'.format(grand_total_net)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
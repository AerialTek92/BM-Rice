<odoo>
    <!-- Paper Format (Landscape for wide table) -->
    <record id="paperformat_stock_picking_landscape" model="report.paperformat">
        <field name="name">Stock Picking Landscape</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
    </record>
    <!-- Report Action -->
    <record id="action_report_payment_certificate_date_wise" model="ir.actions.report">
        <field name="name">Payment Certificate Date Wise</field>
        <field name="model">payment.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mr_rice_addons.report_payment_cert_date_template</field>
        <field name="report_file">mr_rice_addons.report_payment_cert_date_template</field>
        <field name="print_report_name">'Payment_Certificate_Date_Wise'</field>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_stock_picking_landscape"/>
    </record>

    <template id="report_payment_cert_date_template">
        <t t-call="web.html_container">
            <style>
                .pc-container {
                font-family: Arial, sans-serif;
                font-size: 9px;
                color: black;
                }
                .table-pc {
                width: 100%;
                border-collapse: collapse;
                margin-top: 10px;
                }
                .table-pc th, .table-pc td {
                border: 1px solid black;
                padding: 3px;
                vertical-align: top;
                line-height: 1.2;
                }
                .header-bg {
                background-color: #ffffff;
                font-size: 10px
                text-align: center;
                }
                .text-right { text-align: right; }
                .text-center { text-align: center; }
                .bold { font-weight: bold; }

                /* Title Section */
                .title-box {
                text-align: center;
                margin-bottom: 10px;
                font-size: 20px
                }
            </style>

            <div class="page pc-container">
                <!-- Top Header: Title & Page Info -->
                <div class="title-box">
                    <h4 style="margin:0; font-weight: bold;">Payment Certificate Date Wise</h4>
                    <p style="margin:0; font-weight: bold;">PC Date From:
                        <span t-esc="date_from"/>
                        To:
                        <span t-esc="date_to"/>
                    </p>
                </div>

                <table class="table-pc">
                    <thead>
                        <tr class="header-bg">
                            <th rowspan="2" style="width: 8%;">GRN/PC No<br/>PC Date
                            </th>
                            <th rowspan="2" style="width: 10%;">P/O No<br/>P/O Date<br/>GRN Date
                            </th>
                            <th rowspan="2" style="width: 12%;">Supplier Name<br/>Broker Name
                            </th>
                            <th rowspan="2" style="width: 7%;">Net Wt (Kgs)<br/>Bags
                            </th>
                            <th rowspan="2" style="width: 7%;">Rate (Rs)<br/>Amount (Rs)
                            </th>
                            <th colspan="5">Deduction Charges</th>
                            <th colspan="3">Addition Amount</th>
                            <th rowspan="2" style="width: 8%;">Net Amount<br/>(Rs)
                            </th>
                        </tr>
                        <tr class="header-bg">
                            <!-- Deduction Columns -->
                            <th style="width: 5%;">Moisture %<br/>Amount
                            </th>
                            <th style="width: 5%;">Broken %<br/>Amount
                            </th>
                            <th style="width: 5%;">Fill Bag<br/>Amount
                            </th>
                            <th style="width: 5%;">Damage<br/>Weight
                            </th>
                            <th style="width: 8%;">Other<br/>Amt After Ded
                            </th>
                            <!-- Addition Columns -->
                            <th style="width: 6%;">Brokerage<br/>WHT
                            </th>
                            <th style="width: 6%;">Transport</th>
                            <th style="width: 4%;">Other</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="o">
                            <!-- CALCULATION LOGIC -->
                            <!-- 1. Amount After Deduction = Amount - Fill Bag - Less Damage -->
                            <t t-set="amt_after_ded"
                               t-value="o.amount - (o.filling_bags or 0.0) - (o.less_damage or 0.0)"/>

                            <!-- 2. Net Amount = Amt After Ded + Brokerage + Transport + Other -->
                            <t t-set="net_amt"
                               t-value="amt_after_ded + (o.add_brokerage or 0.0) + (o.add_transportation or 0.0) + (o.add_other or 0.0)"/>

                            <tr>
                                <!-- GRN/PC -->
                                <td style="padding: 10px;">
                                    <span t-field="o.grn_id.name"/>
                                    <br/>
                                    <span t-field="o.date" t-options='{"widget": "date", "format": "dd-MM-yy"}'/>
                                </td>
                                <!-- PO/GRN Dates -->
                                <td style="padding: 10px;">
                                    <span t-field="o.purchase_id.name"/>
                                    <br/>
                                    <span t-field="o.purchase_id.date_order"
                                          t-options='{"widget": "date", "format": "dd-MM-yy"}'/>
                                    <br/>
                                    <span t-field="o.grn_id.grn_date"
                                          t-options='{"widget": "date", "format": "dd-MM-yy"}'/>
                                </td>
                                <!-- Names -->
                                <td style="padding: 10px;">
                                    <span t-field="o.partner_id.name"/>
                                    <br/>
                                    <span t-field="o.broker_id.name"/>
                                </td>
                                <!-- Weights -->
                                <td class="text-right" style="padding: 10px;">
                                    <span t-esc="'{0:,.0f}'.format(o.net_weight)"/>
                                    <br/>
                                    <span t-field="o.bags"/>
                                </td>
                                <!-- Rate & Initial Amount -->
                                <td class="text-right" style="padding: 10px;">
                                    <span t-esc="'{0:,.2f}'.format(o.rate)"/>
                                    <br/>
                                    <span t-esc="'{0:,.0f}'.format(o.amount)"/>
                                </td>

                                <!-- DEDUCTIONS -->
                                <td class="text-center" style="padding: 10px;">
                                    <span t-field="o.moisture_actual"/>%
                                </td>
                                <td class="text-center" style="padding: 10px;">
                                    <span t-field="o.broken_actual"/>%
                                </td>
                                <td class="text-right" style="padding: 10px;">
                                    <span t-esc="'{0:,.0f}'.format(o.filling_bags)"/>
                                </td>
                                <td class="text-right" style="padding: 10px;">
                                    <span t-esc="'{0:,.0f}'.format(o.less_damage)"/>
                                </td>
                                <!-- Calculation 1: Other Amt After Ded -->
                                <td class="text-right bold" style="padding: 10px;">
                                    <span t-esc="'{0:,.0f}'.format(amt_after_ded)"/>
                                </td>

                                <!-- ADDITIONS -->
                                <td class="text-right" style="padding: 10px;">
                                    <span t-esc="'{0:,.0f}'.format(o.add_brokerage)"/>
                                </td>
                                <td class="text-right" style="padding: 10px;">
                                    <span t-esc="'{0:,.0f}'.format(o.add_transportation)"/>
                                </td>
                                <td class="text-right" style="padding: 10px;">
                                    <span t-esc="'{0:,.0f}'.format(o.add_other)"/>
                                </td>

                                <!-- Calculation 2: FINAL NET AMOUNT -->
                                <td class="text-right bold" style="padding: 10px;">
                                    <span t-esc="'{0:,.0f}'.format(net_amt)"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

        </t>
    </template>
</odoo>
<odoo>
    <!-- Paper Format (Landscape for wide table) -->
    <record id="paperformat_stock_picking_landscape" model="report.paperformat">
        <field name="name">Stock Picking Landscape</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">0</field>
    </record>
    <!-- Report Action -->
    <record id="action_report_grn_inspection_detail" model="ir.actions.report">
        <field name="name">Goods Receipt Inspection Detail</field>
        <field name="model">grn.inspection</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">mr_rice_addons.report_grn_inspection_detail_template</field>
        <field name="report_file">mr_rice_addons.report_grn_inspection_detail_template</field>
        <field name="print_report_name">'GRN_Inspection_Detail'</field>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_stock_picking_landscape"/>
    </record>

    <template id="report_grn_inspection_detail_template">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <style>
                    .page {
                    font-family: "Times New Roman", Times, serif !important;
                    color: black !important;
                    }
                    .report-header {
                    text-align: center;
                    margin-bottom: 10px;
                    }
                    .report-title {
                    font-size: 18px;
                    font-weight: bold;
                    margin-bottom: 2px;
                    }
                    .report-dates {
                    font-size: 14px;
                    font-weight: bold;
                    margin-bottom: 5px;
                    }
                    .page-info {
                    text-align: right;
                    font-size: 11px;
                    margin-bottom: 2px;
                    }

                    /* Table Styles */
                    .table-main {
                    width: 100%;
                    border-collapse: collapse !important;
                    table-layout: fixed;
                    }

                    /* Header: Full Box with Vertical Lines */
                    .table-main thead th {
                    border: 1px solid black !important;
                    border-top: 2px solid black !important;
                    border-bottom: 2px solid black !important;
                    text-align: center;
                    vertical-align: middle;
                    font-size: 12px;
                    font-weight: bold;
                    padding: 3px;
                    }

                    /* Body: Only Horizontal Lines as per image */
                    .table-main tbody td {
                    border-bottom: 1px solid black !important;
                    border-left: none !important;
                    border-right: none !important;
                    padding: 5px 2px;
                    font-size: 12px;
                    vertical-align: top;
                    line-height: 1.2;
                    }

                    .text-right { text-align: right !important; padding-right: 5px !important; }
                    .text-center { text-align: center !important; }
                    .text-left { text-align: left !important; padding-left: 5px !important; }
                </style>

                <div class="page">
                    <!-- Header Section -->
                    <div class="report-header">
                        <div class="report-title">Goods Receipt Inspection Detail</div>
                        <div class="report-dates">
                            <span t-esc="date_from"/>
                            -
                            <span t-esc="date_to"/>
                        </div>
                    </div>

                    <div class="page-info">
                        Page 1 of 1
                    </div>

                    <!-- Main Table -->
                    <table class="table-main">
                        <thead>
                            <tr>
                                <th style="width: 10%;">Insp. No<br/>Date
                                </th>
                                <th style="width: 20%;">Broker<br/>Party
                                </th>
                                <th style="width: 12%;">Truck No<br/>Billty No.
                                </th>
                                <th style="width: 10%;">Bag/Bardana<br/>Sample No
                                </th>
                                <th style="width: 13%;">Crop Period<br/>Destination
                                </th>
                                <th style="width: 10%;">Broker %<br/>Moisture %
                                </th>
                                <th style="width: 8%;">Damage<br/>Chalky
                                </th>
                                <th style="width: 10%;">Billty<br/>Weight
                                </th>
                                <th style="width: 7%;">Status<br/>TLS
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="o">
                                <t t-foreach="o.inspection_line_ids" t-as="line">
                                    <tr>
                                        <!-- Insp No / Date -->
                                        <td class="text-left">
                                            <span t-field="o.name"/>
                                            <br/>
                                            <span t-field="o.inspection_date"
                                                  t-options='{"widget": "date", "format": "dd-MM-yy"}'/>
                                        </td>
                                        <!-- Broker / Party -->
                                        <td class="text-left">
                                            <div style="text-transform: uppercase;">
                                                <span t-field="o.broker_id.name"/>
                                                <br/>
                                                <span t-field="o.partner_id.name"/>
                                            </div>
                                        </td>
                                        <!-- Truck / Billty -->
                                        <td class="text-left">
                                            <span t-field="line.truck_no"/>
                                            <br/>
                                            <span t-field="line.bilty_no"/>
                                        </td>
                                        <!-- Bag / Bardana -->
                                        <td class="text-center">
                                            <span t-field="line.bags"/>
                                            <span t-field="line.bardana"/>
                                            <br/>
                                            <!-- Sample No remove kar diya hai taake error na aaye -->
                                        </td>
                                        <!-- Crop / Destination -->
                                        <td class="text-left">
                                            <span t-field="line.crop"/>
                                            <br/>
                                            <span t-field="line.destination"/>
                                        </td>
                                        <!-- Percentages -->
                                        <td class="text-right">
                                            <br/> <!-- Broker % placeholder -->
                                            <t t-if="o.moisture_percent">
                                                <span t-field="o.moisture_percent"
                                                      t-options='{"widget": "float", "precision": 2}'/>%
                                            </t>
                                        </td>
                                        <!-- Damage / Chalky -->
                                        <td class="text-right">
                                            <br/> <!-- Damage % placeholder -->
                                            <t t-if="o.chalky_immature_percent">
                                                <span t-field="o.chalky_immature_percent"
                                                      t-options='{"widget": "float", "precision": 2}'/>%
                                            </t>
                                        </td>
                                        <!-- Weight -->
                                        <td class="text-right">
                                            <t t-if="line.bilty_weight">
                                                <span t-esc="'{0:,.0f}'.format(line.bilty_weight)"/>
                                            </t>
                                        </td>
                                        <!-- Status / TLS -->
                                        <td class="text-center">
                                            <t t-if="line.grn_insp_tls == 0">REJECT</t>
                                            <t t-else="">ACCEPT</t>
                                            <br/>
                                            <span t-field="line.grn_insp_tls"
                                                  t-options='{"widget": "float", "precision": 2}'/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
<odoo>
    <!-- 1. Wizard Form View -->
    <record id="view_purchase_order_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.wizard.form</field>
        <field name="model">purchase.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Purchase Order Detail">
                <group>
                    <group>
                        <field name="date_from" required="1"/>
                    </group>
                    <group>
                        <field name="date_to" required="1"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 2. Wizard Window Action -->
    <record id="action_purchase_order_wizard" model="ir.actions.act_window">
        <field name="name">PO Detail Report</field>
        <field name="res_model">purchase.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Report 1: Purchase Section -->
    <menuitem id="menu_purchase_order_report_detail_report"
              name="PO Detail Report"
              parent="menu_purchase_reports_section"
              action="action_purchase_order_wizard"
              sequence="100"/>

    <!-- Default Odoo Menus Link -->
    <menuitem id="menu_purchase_order_report_detail_purchase"
              name="PO Detail Report"
              parent="purchase.purchase_report_main"
              action="action_purchase_order_wizard"
              sequence="100"/>

    <menuitem id="menu_purchase_order_report_detail_sale"
              name="PO Detail Report"
              parent="sale.menu_sale_report"
              action="action_purchase_order_wizard"
              sequence="100"/>
</odoo>
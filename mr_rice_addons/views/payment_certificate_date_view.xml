<odoo>
    <!-- Wizard Form View -->
    <record id="view_payment_cert_date_wizard_form" model="ir.ui.view">
        <field name="name">payment.certificate.date.wizard.form</field>
        <field name="model">payment.certificate.date.wizard</field>
        <field name="arch" type="xml">
            <form string="Payment Certificate Date Wise">
                <sheet>
                    <group>
                        <group>
                            <label for="date_from" string="Date Range"/>
                            <div class="o_row">
                                <field name="date_from"/>
                                To
                                <field name="date_to"/>
                            </div>
                        </group>
                        <group>
                            <field name="date_filter_type" nolabel="0"/>
                        </group>
                    </group>
                    <group>
                        <field name="partner_id" string="Supplier" options="{'no_create': True}"/>
                        <field name="broker_id" options="{'no_create': True}"/>
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="purchase_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <group>
                            <field name="truck_no"/>
                            <field name="rate"/>
                            <field name="show_company"/>
                        </group>
                        <group>
                            <field name="report_type"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_payment_cert_date_wizard" model="ir.actions.act_window">
        <field name="name">Payment Certificate Date Wise</field>
        <field name="res_model">payment.certificate.date.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_payment_cert_date_report_main"
              name="Payment Certificate Date Wise"
              parent="account.menu_finance_reports"
              action="action_payment_cert_date_wizard"
              sequence="110"/>
    <!-- 3. Menu Item (C.Menu Accounting -> Reporting) -->
    <menuitem id="menu_payment_cert_date_report_account"
              name="Payment Certificate Date Wise"
              parent="menu_accounting_reports_section"
              action="action_payment_cert_date_wizard"
              sequence="110"/>
</odoo>
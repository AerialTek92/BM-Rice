<odoo>
    <record id="view_stock_picking_detail_wizard_form" model="ir.ui.view">
        <field name="name">stock.picking.detail.wizard.form</field>
        <field name="model">stock.picking.detail.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Good Receipt Detail">
                <group>
                    <group>
                        <field name="date_from"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_picking_detail_wizard" model="ir.actions.act_window">
        <field name="name">Good Receipt Report</field>
        <field name="res_model">stock.picking.detail.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_stock_picking_detail"
              name="Good Receipt Report"
              parent="stock.menu_warehouse_report"
              action="action_stock_picking_detail_wizard"
              sequence="100"/>
</odoo>
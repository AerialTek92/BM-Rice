<odoo>
    <!-- 1. Wizard Form View -->
    <record id="view_outstanding_arrival_wizard_form" model="ir.ui.view">
        <field name="name">outstanding.arrival.wizard.form</field>
        <field name="model">outstanding.arrival.wizard</field>
        <field name="arch" type="xml">
            <form string="Outstanding Arrival Report">
                <group>
                    <field name="as_on_date"/>
                </group>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 2. Wizard Action -->
    <record id="action_outstanding_arrival_wizard" model="ir.actions.act_window">
        <field name="name">Outstanding Arrival Report</field>
        <field name="res_model">outstanding.arrival.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- 3. Menu Item (Purchase -> Reporting) -->
    <menuitem id="menu_outstanding_arrival_report_purchase"
              name="Outstanding Arrival"
              parent="purchase.purchase_report_main"
              action="action_outstanding_arrival_wizard"
              sequence="160"/>
    <!-- 3. Menu Item (Purchase -> Reporting) -->
    <menuitem id="menu_outstanding_arrival_report_sale"
              name="Outstanding Arrival"
              parent="sale.menu_sale_report"
              action="action_outstanding_arrival_wizard"
              sequence="160"/>
    <!-- 3. Menu Item (Rice Reports -> Reporting) -->
    <menuitem id="menu_outstanding_arrival_report_purchase_report"
              name="Outstanding Arrival"
              parent="menu_purchase_reports_section"
              action="action_outstanding_arrival_wizard"
              sequence="160"/>
</odoo>
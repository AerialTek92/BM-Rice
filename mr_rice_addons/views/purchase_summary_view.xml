<odoo>
    <!-- 1. Wizard Form View (Advanced Layout) -->
    <record id="view_purchase_order_summary_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.summary.wizard.form</field>
        <field name="model">purchase.order.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Purchase Order Summary">
                <sheet>
                    <group>
                        <group>
                            <label for="date_from" string="Date Range"/>
                            <div class="o_row">
                                <field name="date_from" widget="date"/>
                                <span class="o_sep">To</span>
                                <field name="date_to" widget="date"/>
                            </div>
                        </group>
                        <group>
                            <field name="date_filter_type" widget="selection"/>
                        </group>
                    </group>

                    <group>
                        <group string="Filters">
                            <field name="partner_id" string="Supplier" options="{'no_create': True}"/>
                            <field name="broker_id" options="{'no_create': True}"/>
                            <field name="product_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Report Settings">
                            <field name="report_type" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report" string="Print Summary" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 2. Wizard Action -->
    <record id="action_purchase_order_summary_wizard" model="ir.actions.act_window">
        <field name="name">Purchase Order Summary</field>
        <field name="res_model">purchase.order.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- 3. Menu Item (Purchase Reporting Menu mein) -->
    <menuitem id="menu_purchase_order_report_summary_purchase_report"
              name="Purchase Order Summary"
              parent="menu_purchase_reports_section"
              action="action_purchase_order_summary_wizard"
              sequence="110"/>
    <!-- 3. Menu Item (Purchase Reporting Menu mein) -->
    <menuitem id="menu_purchase_order_report_summary_purchase"
              name="Purchase Order Summary"
              parent="purchase.purchase_report_main"
              action="action_purchase_order_summary_wizard"
              sequence="110"/>
    <!-- 3. Menu Item (Sale Reporting Menu mein) -->
    <menuitem id="menu_purchase_order_report_summary_sale"
              name="Purchase Order Summary"
              parent="sale.menu_sale_report"
              action="action_purchase_order_summary_wizard"
              sequence="110"/>
</odoo>
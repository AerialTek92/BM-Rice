<odoo>
    <!-- 1. Wizard Form View (Advanced Reference Style) -->
    <record id="view_rice_deduction_wizard_form" model="ir.ui.view">
        <field name="name">rice.allowance.deduction.wizard.form</field>
        <field name="model">rice.allowance.deduction.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Rice Allowance Deduction">
                <sheet>
                    <group>
                        <group>
                            <label for="date_from" string="Date Range"/>
                            <div class="o_row">
                                <field name="date_from" widget="date"/>
                                <span class="o_sep">To</span>
                                <field name="date_to" widget="date"/>
                            </div>
                        </group>
                        <group>
                            <field name="date_filter_type" widget="selection"/>
                        </group>
                    </group>

                    <group>
                        <group string="Primary Filters">
                            <field name="partner_id" string="Supplier" options="{'no_create': True, 'no_open': True}"/>
                            <field name="broker_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group string="Additional Filters">
                            <field name="purchase_ids" widget="many2many_tags" options="{'no_create': True}"
                                   placeholder="Select POs..."/>
                            <field name="report_type" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report" string="Print Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 2. Wizard Action -->
    <record id="action_rice_deduction_wizard" model="ir.actions.act_window">
        <field name="name">Rice Allowance Deduction</field>
        <field name="res_model">rice.allowance.deduction.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- 3. Menu Item (Inventory Reporting mein) -->
    <menuitem id="menu_rice_deduction_report"
              name="Rice Allowance Deduction"
              parent="stock.menu_warehouse_report"
              action="action_rice_deduction_wizard"
              sequence="140"/>
    <!-- 3. Menu Item (Inventory Reporting mein) -->
    <menuitem id="menu_rice_deduction_report_inventory"
              name="Rice Allowance Deduction"
              parent="menu_inventory_reports_section"
              action="action_rice_deduction_wizard"
              sequence="140"/>
</odoo>
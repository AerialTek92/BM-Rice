<odoo>
    <!-- Wizard Form View -->
    <record id="view_invoice_date_wizard_form" model="ir.ui.view">
        <field name="name">invoice.date.wizard.form</field>
        <field name="model">invoice.date.wizard</field>
        <field name="arch" type="xml">
            <form string="Sale Rice Date Wise">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="partner_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                        <field name="product_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="category_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_invoice_date_wizard" model="ir.actions.act_window">
        <field name="name">Sale Rice Date Wise</field>
        <field name="res_model">invoice.date.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_invoice_date_wise_report_rice"
              name="Sale Rice Date Wise"
              parent="sale.menu_sale_report"
              action="action_invoice_date_wizard"
              sequence="20"/>

    <menuitem id="menu_invoice_date_wise_report_rice"
              name="Sale Rice Date Wise"
              parent="menu_sales_reports_section"
              action="action_invoice_date_wizard"
              sequence="20"/>
</odoo>
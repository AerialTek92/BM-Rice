<odoo>
    <!-- 1. Wizard Form View -->
    <record id="view_invoice_date_wizard_form" model="ir.ui.view">
        <field name="name">invoice.date.wizard.form</field>
        <field name="model">invoice.date.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Invoice Date Wise">
                <group>
                    <group>
                        <field name="date_from"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- 2. Wizard Action -->
    <record id="action_invoice_date_wizard" model="ir.actions.act_window">
        <field name="name">Invoice Date Wise</field>
        <field name="res_model">invoice.date.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- 3. Menu Item (Sales -> Reporting) -->
    <menuitem id="menu_invoice_date_wise_report"
              name="Invoice Date Wise"
              parent="sale.menu_sale_report"
              action="action_invoice_date_wizard"
              sequence="20"/>
</odoo>
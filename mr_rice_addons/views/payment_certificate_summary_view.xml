<odoo>
    <!-- 1. Wizard Form View -->
        <record id="view_payment_certificate_wizard_form" model="ir.ui.view">
            <field name="name">payment.certificate.wizard.form</field>
            <field name="model">payment.certificate.wizard</field>
            <field name="arch" type="xml">
                <form string="Print Payment Certificate Summary">
                    <group>
                        <group><field name="date_from"/></group>
                        <group><field name="date_to"/></group>
                    </group>
                    <footer>
                        <button name="action_print_report" string="Print PDF" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- 2. Wizard Action -->
        <record id="action_payment_certificate_wizard" model="ir.actions.act_window">
            <field name="name">Payment Certificate Summary</field>
            <field name="res_model">payment.certificate.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- 3. Menu Item (Accounting Reporting Menu mein) -->
        <!-- Parent ID: account.menu_finance_reports (Accounting -> Reporting) -->
        <menuitem id="menu_payment_certificate_report"
                  name="Payment Certificate Summary"
                  parent="account.menu_finance_reports"
                  action="action_payment_certificate_wizard"
                  sequence="100"/>
</odoo>
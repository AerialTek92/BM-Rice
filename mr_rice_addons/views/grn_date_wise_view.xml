<odoo>
    <!-- Wizard View -->
    <record id="view_stock_picking_date_wizard_form" model="ir.ui.view">
        <field name="name">stock.picking.date.wizard.form</field>
        <field name="model">stock.picking.date.wizard</field>
        <field name="arch" type="xml">
            <form string="Goods Receipt Date Wise">
                <sheet>
                    <group>
                        <group>
                            <label for="date_from" string="Date From"/>
                            <div class="o_row">
                                <field name="date_from"/>
                                <span>To</span>
                                <field name="date_to"/>
                            </div>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="broker_id" options="{'no_create': True}"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="purchase_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="location_id" options="{'no_create': True}"/>
                            <field name="truck_no"/>
                            <field name="pending_pay_cert"/>
                            <field name="show_company"/>
                        </group>
                    </group>
                    <group string="Quality Range">
                        <group>
                            <label for="moisture_from" string="Moisture %"/>
                            <div class="o_row">
                                <field name="moisture_from"/>
                                To
                                <field name="moisture_to"/>
                            </div>
                        </group>
                        <group>
                            <label for="broken_from" string="Broken %"/>
                            <div class="o_row">
                                <field name="broken_from"/>
                                To
                                <field name="broken_to"/>
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_stock_picking_date_wizard" model="ir.actions.act_window">
        <field name="name">Goods Receipt Date Wise</field>
        <field name="res_model">stock.picking.date.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_grn_date_wise_report_inventory"
              name="Goods Receipt Date Wise"
              parent="stock.menu_warehouse_report"
              action="action_stock_picking_date_wizard"
              sequence="160"/>

    <!-- 3. Menu Item -->
    <menuitem id="menu_grn_date_wise_report_inventory"
              name="Goods Receipt Date Wise"
              parent="menu_inventory_reports_section"
              action="action_stock_picking_date_wizard"
              sequence="160"/>
</odoo>
<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_account_account_search_inherit_legacy_coa"
            model="ir.ui.view">

        <field name="name">
            account.account.search.inherit.legacy.coa
        </field>

        <field name="model">account.account</field>

        <field name="inherit_id" ref="account.view_account_search"/>

        <field name="arch" type="xml">

            <!-- ================================================= -->
            <!-- ADD CUSTOM SEARCH FIELDS -->
            <!-- ================================================= -->

            <xpath expr="//search" position="inside">

                <field name="level_1_group_id"/>

                <field name="level_2_group_id"/>

                <field name="group_id"/>

            </xpath>


            <!-- ================================================= -->
            <!-- ADD GROUP BY -->
            <!-- ================================================= -->

            <xpath expr="//search/group" position="inside">

                <filter
                    name="group_by_level_1"
                    string="Level 1 Group"
                    context="{'group_by': 'level_1_group_id'}"
                />

                <filter
                    name="group_by_level_2"
                    string="Level 2 Group"
                    context="{'group_by': 'level_2_group_id'}"
                />

                <filter
                    name="group_by_account_group"
                    string="Account Group"
                    context="{'group_by': 'group_id'}"
                />

            </xpath>

        </field>

    </record>

</odoo>
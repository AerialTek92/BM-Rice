<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        LOCAL SALES FLOW: the D/O dropdown on an Outbound Gate Pass must only offer
        Delivery Orders whose commercial quantities were approved by the Sales user
        (User A). Export deliveries keep their native behavior (no commercial
        validation step exists for them), hence the export exception in the domain.
    -->
    <record id="gate_pass_view_form_local_sales_inherit" model="ir.ui.view">
        <field name="name">gate.pass.form.local.sales.inherit</field>
        <field name="model">gate.pass</field>
        <field name="inherit_id" ref="arm_rice_mill.gate_pass_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='delivery_picking_id']" position="attributes">
                <attribute name="domain">[
                    ('picking_type_code', '=', 'outgoing'),
                    ('state', 'not in', ['done', 'cancel']),
                    '|', ('contract_type', '=', 'export'), ('is_commercially_validated', '=', True),
                    '|',
                    ('sale_id', '=', sale_order_id if sale_order_id else -1),
                    ('rice_sales_contract_id', '=', export_sales_contract_id if export_sales_contract_id else -1)
                ]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Override native Odoo sale order sequence to SM -->
        <record id="sale.seq_sale_order" model="ir.sequence">
            <field name="prefix">SM%(y)s/</field>
        </record>

                <!-- Delivery Order sequences: Export vs Local -->
        <record id="seq_do_export" model="ir.sequence">
            <field name="name">Export Delivery Order</field>
            <field name="code">do.export</field>
            <field name="prefix">EXP/DO/%(y)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_do_local" model="ir.sequence">
            <field name="name">Local Delivery Order</field>
            <field name="code">do.local</field>
            <field name="prefix">SM/DO/%(y)s/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
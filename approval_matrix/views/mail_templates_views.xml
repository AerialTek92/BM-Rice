<odoo>
    <data noupdate="0">
        <record id="email_template_po_verification" model="mail.template">
            <field name="name">email_template_po_verification</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">PO Verification Needed: {{ object.name }}</field>
            <field name="body_html" type="html">
                <div style="padding:20px; border:1px solid #ddd;">
                    <p>Hello<t t-out="ctx.get('approver_name')"/>,
                    </p>
                    <p>Please verify PO
                        <b>
                            <t t-out="object.name"/>
                        </b>
                    </p>
                    <a t-att-href="object.get_base_url() + '/po/approval/' + str(object.id) + '/verify'"
                       style="padding:10px; background:#28a745; color:#fff; text-decoration:none; border-radius:5px;">
                        Verify Now
                    </a>
                </div>
            </field>
        </record>

        <record id="email_template_po_final_approval" model="mail.template">
            <field name="name">email_template_po_final_approval</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">Final PO Approval Needed: {{ object.name }}</field>
            <field name="body_html" type="html">
                <div style="padding:20px; border:1px solid #ddd;">
                    <p>Hello<t t-out="ctx.get('approver_name')"/>,
                    </p>
                    <p>PO
                        <b>
                            <t t-out="object.name"/>
                        </b>
                        needs Final Approval.
                    </p>
                    <a t-att-href="object.get_base_url() + '/po/approval/' + str(object.id) + '/approve'"
                       style="padding:10px; background:#007bff; color:#fff; text-decoration:none; border-radius:5px;">
                        Approve Now
                    </a>
                </div>
            </field>
        </record>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_matrix_form" model="ir.ui.view">
        <field name="name">approval.matrix.form</field>
        <field name="model">approval.matrix</field>
        <field name="arch" type="xml">
            <form string="Approval Matrix">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="model_id"/>
                        <!-- NEW: Scoping Field -->
                        <field name="rice_type"/>
                    </group>
                    <notebook>
                        <page string="Approvers">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="label"/>
                                    <field name="employee_id" string="Specific Approver" invisible="group_id != False"/>
                                    <field name="group_id" string="Approval Group" invisible="employee_id != False"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_approval_matrix_tree" model="ir.ui.view">
        <field name="name">approval.matrix.tree</field>
        <field name="model">approval.matrix</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="rice_type"/>
            </list>
        </field>
    </record>

    <record id="action_approval_matrix" model="ir.actions.act_window">
        <field name="name">Approval Matrix</field>
        <field name="res_model">approval.matrix</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_approval_matrix_technical" name="Approval Matrix" parent="base.menu_users" action="action_approval_matrix"/>
</odoo>